{#
  A plain form, submitted with a real button. No JavaScript is involved, so the
  control works identically with scripting disabled (specification.md 11).
  The server renders the chosen theme into <html data-theme>, so there is no
  flash of the wrong colours on first paint.
#}
<form class="theme-switch"
      method="post"
      action="{{ url_for('set_theme') }}">
  {#
    Anonymous visitors have no session and so no token to send; the gate only
    demands one when a session cookie is present.  Including it unconditionally
    is what keeps the control working once somebody signs in (7.3).
  #}
  {% include "partials/csrf.html.j2" %}
  <input type="hidden" name="next" value="{{ current_path }}">
  <fieldset>
    <legend>Colour theme</legend>
    {% for option in themes %}
      <span class="theme-option">
        <input type="radio"
               id="theme-{{ option }}"
               name="theme"
               value="{{ option }}"
               {% if option == theme %}checked{% endif %}>
        <label for="theme-{{ option }}">{{ option | capitalize }}</label>
      </span>
    {% endfor %}
    <button type="submit">Apply</button>
  </fieldset>
</form>
